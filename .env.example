# Forge CMS — environment variables
#
# Copy to .env.local for local development. Never commit real values.
# Names and explanations only (Forgeline style). Values for local development
# with docker-compose are shown where they are not secrets.
#
# Everything is read lazily and validated by src/platform/config/env.ts, so a
# missing variable never crashes an import; /api/health/ready reports it.

# --- Database ------------------------------------------------------------------
# Runtime: Neon POOLED connection string for role forge_app (RLS enforced).
# Local: through PgBouncer (transaction mode), like production.
DATABASE_URL=postgres://forge_app:forge_app@localhost:6432/forge
# Migrations only (CI / local). Neon DIRECT (unpooled) URL for role forge_owner.
# Never set in the Vercel runtime.
DATABASE_MIGRATION_URL=postgres://forge_owner:forge_owner@localhost:5432/forge

# --- Hosts (ADR 0006) -----------------------------------------------------------
# V1 runs on ONE origin: admin, /api/v1, tenant sites at /s/{address}, /media.
# Production: https://cms.forgelinetechnologies.com
# Vercel previews: leave APP_ORIGIN unset for the Preview environment; it
# defaults to the branch URL.
APP_ORIGIN=http://localhost:3000
# Post-V1 only (paid hosting): tenant sites on their own hosts.
# HOST_ROUTING_ENABLED=true serves {address}.SITES_ROOT_DOMAIN and custom domains.
HOST_ROUTING_ENABLED=false
SITES_ROOT_DOMAIN=
# Public media URL prefix. Empty = ${APP_ORIGIN}/media (served by the app).
MEDIA_PUBLIC_BASE_URL=

# --- Auth (Better Auth, D-07) --------------------------------------------------
# BETTER_AUTH_SECRET: 32+ random bytes, e.g. `openssl rand -base64 32`.
# BETTER_AUTH_URL:    the app origin, e.g. http://localhost:3000
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Resend) ------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=

# --- Object storage (S3-compatible: R2 in production, RustFS locally) -----------
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Billing (Stripe) — M11 ----------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# --- Custom domains (Vercel Domains API) — post-V1 (needs paid hosting) ---------
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# --- Security --------------------------------------------------------------------
# CRON_SECRET authenticates calls to /api/internal/cron (and /daily): Vercel
# Cron, or an external scheduler on the free plan (runbook §5).
# PREVIEW_TOKEN_SECRET signs preview tokens (separate from the auth secret).
CRON_SECRET=
PREVIEW_TOKEN_SECRET=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Observability ---------------------------------------------------------------
# DSNs are optional: without them Sentry stays disabled and errors are only logged.
# SENTRY_ORG / SENTRY_PROJECT / SENTRY_AUTH_TOKEN: build-time source-map upload (Vercel only).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# debug | info | warn | error
LOG_LEVEL=info

# --- Staff -------------------------------------------------------------------------
# Comma-separated emails allowed into /platform (M12-2).
PLATFORM_ADMIN_EMAILS=
